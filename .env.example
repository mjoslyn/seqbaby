PORT=5173

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — browser-safe with RLS enabled
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret key (sb_secret_...) — server-only; needed for admin/service operations.
# Sample storage (app/api/sample) and anonymous shares (lib/api.js) write with
# it; without it samples stay inline in songs and shares fall back to Netlify
# Blobs, which is how both worked before.
# SUPABASE_SECRET_KEY=sb_secret_xxx
# Stored samples (migration 0020) -- all OPTIONAL. The salt the quota hashes
# addresses with (defaults to the secret key), the daily upload limits in MB
# (per address signed out, per account signed in, across everyone), and the
# cleanup job's deletion of samples nothing names (off unless set to 1).
# SAMPLE_IP_SALT=some-long-random-string
# SAMPLE_QUOTA_ANON_MB=50
# SAMPLE_QUOTA_USER_MB=200
# SAMPLE_QUOTA_GLOBAL_MB=5120
# SAMPLE_GC_DELETE=1
# SAMPLE_GC_GRACE_DAYS=30
# Jamming (the `jam` button) runs over the same project's Realtime, as public
# broadcast + presence channels: nothing to set beyond the two keys above, as
# long as Realtime is enabled for the project and public channels are allowed.

# Compose chat (app/api/compose) — an in-studio "make me a beat" panel backed
# by the same songBuilder tools as the MCP server. Server-only, and OPTIONAL:
# it is the key logged-in visitors compose on, and without it the panel simply
# offers the other way in, which is a visitor's own key typed into the panel
# (never stored server-side). Set it and signed-in accounts get a "this site"
# option beside "your own".
ANTHROPIC_API_KEY=sk-ant-xxx
# Which model a compose turn runs on when the request doesn't name one. The
# compose panel's dropdown picks per message and overrides this; it is the
# fallback for the MCP server and for anything older than that dropdown.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# PostHog analytics (instrumentation-client.ts) — OPTIONAL. Browser-safe project
# key; unset means no analytics. Host is https://eu.i.posthog.com for EU projects.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Superbugs page (app/superbugs, app/api/bugs) — OPTIONAL. A fine-grained GitHub
# token with Issues: write on the repo, server-only. Without it the form falls
# back to a prefilled github.com new-issue link.
# GITHUB_ISSUES_TOKEN=github_pat_xxx
# GITHUB_ISSUES_REPO=mjoslyn/seqbaby
# Cloudflare Turnstile on that form — OPTIONAL. The site key is public and read at
# BUILD time (redeploy after setting it); the secret is server-only. With the
# secret set, /api/bugs refuses a report without a valid token.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
