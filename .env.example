# Build-time and client-side settings (Next reads .env). Secrets and bindings
# are the Worker's: see .dev.vars.example and wrangler.jsonc.

# PostHog analytics (instrumentation-client.ts) — OPTIONAL. Browser-safe project
# key; unset means no analytics. Host is https://eu.i.posthog.com for EU projects.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile on the superbugs form — OPTIONAL. The site key is public
# and read at BUILD time (rebuild after setting it); its secret is a Worker
# secret (.dev.vars.example).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
